generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_V2")
}

enum Role {
  CUSTOMER
  DELIVERY_PARTNER
  RESTAURANT_OWNER
  RESTAURANT_TEAM
  MANAGEMENT
  BUSINESS
}

enum VehicleType {
  BIKE
  CYCLE
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum ChatStatus {
  OPEN // The chat has been started but not yet responded to
  IN_PROGRESS // A support agent is actively handling the issue
  RESOLVED // The issue has been resolved successfully
  CLOSED // The chat is closed without resolution or due to inactivity
}

model User {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email           String   @unique
  name            String
  profileImageUrl String?
  role            Role
  password        String
  refreshToken    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations (Single Table Inheritance)
  customer        Customer?
  deliveryPartner DeliveryPartner?
  restaurantOwner RestaurantOwner?

  participatedChats       Chat[]
  sentMessages            Message[]
  messageReadStatuses     MessageReadStatus[]
  messageDeliveryStatuses MessageDeliveryStatus[]
}

model Customer {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  dateOfBirth DateTime
  phone       BigInt
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryPartner {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone        BigInt
  availability Boolean     @default(false)
  vehicleType  VehicleType
  userId       String      @unique @db.Uuid
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RestaurantOwner {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone     BigInt
  panNumber String
  userId    String @unique @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chat {
  id       String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messages Message[]
  status   ChatStatus @default(OPEN)

  // Many-to-Many relation for participants
  participants User[]
}

model Message {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content     String?
  messageType MessageType

  senderId String @db.Uuid
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  chatId String @db.Uuid
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  deliveredTo MessageDeliveryStatus[]
  readBy      MessageReadStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MessageDeliveryStatus {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  deliveredAt DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}

model MessageReadStatus {
  id     String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  readAt DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}
